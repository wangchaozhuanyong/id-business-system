{
  "name": "apple-id-business-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ID 业务管理系统",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev:api": "npm run dev --workspace @apple-business/api",
    "dev:admin": "npm run dev --workspace @apple-business/admin",
    "build": "npm run build --workspaces --if-present",
    "build:cloudflare-free": "npm run build --workspace @apple-business/shared && npm run build --workspace @apple-business/admin",
    "build:supabase-v2-api": "npm run build --workspace @apple-business/shared && npm run prisma:generate --workspace @apple-business/api && npm run build:cloudflare --workspace @apple-business/api && node scripts/build-supabase-v2-api.mjs",
    "build:supabase-v2-api:perf": "npm run build --workspace @apple-business/shared && npm run prisma:generate --workspace @apple-business/api && npm run build:cloudflare --workspace @apple-business/api && node scripts/build-supabase-v2-api.mjs --function-name=v2-api-perf",
    "supabase:local:migrate": "DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public npm run prisma:migrate:deploy --workspace @apple-business/api",
    "cloudflare:free:dry-run": "npm run build:cloudflare-free && npx wrangler@4.114.0 deploy --config wrangler.cloudflare-free.jsonc --dry-run",
    "cloudflare:free:dev": "npm run build:cloudflare-free && npx wrangler@4.114.0 dev --config wrangler.cloudflare-free.jsonc",
    "check": "npm run format:check && npm run lint && npm run check:element-plus && npm run check:admin-ui && npm run check:v2-color-contrast && npm run check:v2-loading-standard && npm run check:v2-table-standard && npm run check:v2-module-architecture && npm run check:v2-isolation && npm run check:v2-decimal-standard && npm run check:v2-prisma-runtime-boundary && npm run check:cloud-independence && npm run typecheck && npm run test && npm run build && npm run prisma:validate && npm run audit:high",
    "typecheck": "npm run build --workspace @apple-business/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check:element-plus": "node scripts/check-element-plus-components.mjs",
    "check:admin-ui": "node scripts/check-admin-ui-guardrails.mjs",
    "check:v2-color-contrast": "node scripts/check-v2-color-contrast.mjs",
    "check:v2-loading-standard": "node scripts/check-v2-loading-standard.mjs",
    "check:v2-table-standard": "node scripts/check-v2-table-standard.mjs",
    "check:v2-module-architecture": "node scripts/check-v2-module-architecture.mjs",
    "check:v2-isolation": "node scripts/check-v2-isolation.mjs",
    "check:v2-decimal-standard": "node scripts/check-v2-decimal-standard.mjs",
    "check:v2-prisma-runtime-boundary": "node scripts/check-v2-prisma-runtime-boundary.mjs",
    "check:cloud-independence": "node scripts/check-cloud-independence.mjs",
    "check:cloud-independence:strict": "node scripts/check-cloud-independence.mjs --require-supabase",
    "check:v2-excel-scope": "python3 scripts/check-v2-excel-scope.py",
    "check:v2-excel-implementation": "node scripts/check-v2-excel-implementation.mjs",
    "check:v2-manual-runtime": "node scripts/check-v2-manual-runtime.mjs",
    "check:v2-manual-runtime:built": "node scripts/check-v2-manual-runtime.mjs --require-build",
    "check:v2-excel": "npm run check:v2-excel-scope && npm run check:v2-excel-implementation && npm run check:v2-manual-runtime",
    "acceptance:v2-draft-retention": "node scripts/acceptance-v2-draft-retention.mjs",
    "acceptance:v2-navigation-performance": "node scripts/acceptance-v2-navigation-performance.mjs",
    "acceptance:v2-realtime": "node scripts/acceptance-v2-realtime.mjs",
    "acceptance:v2-color-contrast": "node scripts/acceptance-v2-color-contrast.mjs",
    "acceptance:v2-table-layout": "node scripts/acceptance-v2-table-layout.mjs",
    "acceptance:v2-session-reliability": "node scripts/acceptance-v2-session-reliability.mjs",
    "acceptance:v2-decimal-adapters": "node scripts/acceptance-v2-decimal-adapters.mjs",
    "acceptance:v2-data-governance": "node scripts/acceptance-v2-data-governance.mjs",
    "acceptance:v2-stage4": "node scripts/acceptance-v2-stage4.mjs",
    "acceptance:v2-stage6": "node scripts/acceptance-v2-stage6.mjs",
    "acceptance:v2-stage7": "node scripts/acceptance-v2-stage7.mjs",
    "acceptance:v2-stage8": "node scripts/acceptance-v2-stage8.mjs",
    "acceptance:v2-stage2602": "node scripts/acceptance-v2-stage2602.mjs",
    "acceptance:v2-stage2603": "node scripts/acceptance-v2-stage2603.mjs",
    "acceptance:v2-stage2802": "npm run build --workspace @apple-business/api && node scripts/acceptance-v2-stage2802.mjs",
    "probe:v2-api-performance": "node scripts/probe-v2-api-performance.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:release-scripts && npm run test --workspaces --if-present",
    "test:release-scripts": "node --test scripts/cloudflare-proxy-worker.test.mjs scripts/cloudflare-release.test.mjs scripts/development-data-cleanup.test.mjs scripts/production-backup.test.mjs scripts/production-command-profiles.test.mjs scripts/production-closure-audit.test.mjs scripts/production-data-maintenance.test.mjs",
    "recovery:data-maintenance": "node scripts/production-data-maintenance.mjs",
    "audit:high": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "prisma:generate": "npm run prisma:generate --workspace @apple-business/api",
    "prisma:validate": "npm run prisma:validate --workspace @apple-business/api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @apple-business/api",
    "prisma:migrate:production": "node scripts/deploy-production-migrations.mjs",
    "prisma:seed": "npm run prisma:seed --workspace @apple-business/api",
    "prod:config": "docker compose --env-file .env.production -f docker-compose.prod.yml config",
    "prod:config:example": "PROD_ENV_FILE=.env.production.example docker compose --env-file .env.production.example -f docker-compose.prod.yml config",
    "prod:env:check": "node scripts/validate-production-env.mjs",
    "prod:smoke": "bash scripts/deploy-smoke.sh",
    "backup:production": "node scripts/backup-production-database.mjs",
    "backup:verify": "node scripts/verify-production-backup.mjs",
    "restore:drill": "node scripts/restore-production-backup-drill.mjs",
    "backup:role:provision": "node scripts/provision-production-backup-role.mjs",
    "backup:key:generate": "node scripts/generate-production-backup-key.mjs",
    "backup:drill:monthly": "node scripts/run-monthly-production-restore-drill.mjs",
    "backup:drill:install": "node scripts/install-production-restore-drill-launchd.mjs",
    "backup:postgres": "npm run backup:production --",
    "restore:verify": "npm run backup:verify --",
    "git:readiness": "node scripts/git-readiness.mjs",
    "git:readiness:verbose": "node scripts/git-readiness.mjs --verbose",
    "audit:v2-production-closure": "node scripts/production-closure-audit.mjs",
    "audit:v2-production-closure:production": "node scripts/run-with-cloudflare-free-secrets.mjs closure-audit",
    "check:cloudflare-release": "node scripts/run-with-cloudflare-free-secrets.mjs release-check",
    "prod:smoke-user:provision": "node scripts/run-with-cloudflare-free-secrets.mjs smoke-user-provision",
    "prod:smoke-user:provision:with-env": "npm run prisma:generate --workspace @apple-business/api && npm run build --workspace @apple-business/api && node scripts/provision-production-smoke-user.mjs",
    "deploy:production": "node scripts/run-with-cloudflare-free-secrets.mjs deploy",
    "deploy:production:with-env": "node scripts/deploy-cloudflare-free.mjs",
    "deploy:api": "npm run deploy:production",
    "deploy:admin": "npm run deploy:production",
    "deploy:pm2-api": "bash scripts/deploy-pm2-api.sh"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "playwright": "^1.62.0",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "dependencies": {
    "@nestjs/jwt": "^11.0.2"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.2.0"
    }
  }
}
