# Privately configure distinct secrets before running the Vendure executor.
ID_VENDURE_WORKER_SECRET=
ID_RECHARGE_BRIDGE_SECRET=
ID_CODEXDAICHONG_ASSETS_FILE=

# Private Unix socket directory for the ID app, and the socket path mounted into the Vendure gateway.
ID_VENDURE_ADMISSION_DIRECTORY=
ID_VENDURE_ADMISSION_SOCKET=

# 独立站外探针。站点和探针只共享签名密钥，其余值仅由探针进程读取。
ID_MONITOR_PROBE_SECRET=
ID_MONITOR_PROBE_ORIGIN=
ID_MONITOR_PROBE_BOT_TOKEN=
ID_MONITOR_PROBE_CHAT_ID=
ID_MONITOR_PROBE_STATE_DIR=

# 可选的备份及表格监控回执目录。它使用独立挂载，业务数据目录仍为只读。
ID_MONITOR_WORKER_RECEIPTS_DIR=
# 站点只读挂载的数据库备份状态目录。
ID_MONITOR_BACKUP_RECEIPTS_DIR=

# 网站登录保护。真人验证两项一起配置。密钥只配置到网站进程。
ID_TURNSTILE_SITE_KEY=
ID_TURNSTILE_SECRET_KEY=
ID_AUTH_MFA_KEY=
ID_AUTH_TRUSTED_PROXY_KEY=

# Private original engine, published only to 127.0.0.1 by its container.
# start/start-production verify the actual container bindings before starting the adapter.
ID_RECHARGE_NATIVE_URL=
ID_RECHARGE_NATIVE_CONTAINER=
# Ephemeral host-launcher injection after actual docker inspect; never hand-fill or save a proof.
ID_RECHARGE_NATIVE_NETWORK_PROOF=
# Existing original-engine signing setting, shared privately with the adapter.
# Must differ from ID_RECHARGE_BRIDGE_SECRET. Never expose it to a browser.
ADMIN_TOKEN_SECRET=

# Existing upstream engine options; configure these in its private runtime environment.
# Empty values keep the pinned engine defaults. The proxy inventory stays managed by the engine.
BROWSER_POOL=
BROWSER_POOL_SIZE=
BROWSER_POOL_MAX_SIZE=
BROWSER_POOL_BASE_PORT=
BROWSER_POOL_ACQUIRE_TIMEOUT_MS=
HEADFUL=
CHROMIUM_CHANNEL=
PLAYWRIGHT_BROWSERS_PATH=
PROXY=
MAX_CONCURRENT_ACTIVATIONS=
PROCESS_IDLE_TIMEOUT_MS=
PAYMENT_MAX_CARD_ATTEMPTS=
CHECKOUT_UI_MODE=
CHECKOUT_READY_WAIT_MS=
RECORD_VIDEO=
JSON_BODY_LIMIT=
