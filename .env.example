# Application
NODE_ENV=development
APP_PORT=3000
APP_PUBLIC_URL=http://localhost:5374
CORS_ORIGIN=http://localhost:5374

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/id_business_v2?schema=public
# AWS 单机 MySQL 部署所需变量；本地 PostgreSQL 开发可留空。
COMPOSE_PROJECT_NAME=id-business-v2-prod
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST_PORT=3306
V2_RUNTIME_DATABASE_URL=
AUDIT_DATABASE_URL=
MIGRATION_DATABASE_URL=
BACKUP_DATABASE_URL=

# Authentication
AUTH_PROVIDER=local
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# Supabase Auth (required only when AUTH_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_EDGE_FUNCTION=false
V2_TRUSTED_PROXY_SECRET=
V2_DB_POOLER_HOST=

# Sensitive fields
FIELD_ENCRYPTION_KEY=change_me_32_bytes_minimum
HASH_SECRET=change_me_hash_secret

# Initial administrator
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_admin_password
SEED_ADMIN_DISPLAY_NAME=管理员
SEED_ADMIN_RESET_PASSWORD=false

# Production read-only smoke account
SMOKE_TEST_USERNAME=
SMOKE_TEST_PASSWORD=

# Frontend
VITE_API_BASE_URL=/api
VITE_DEV_API_PROXY_TARGET=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_FUNCTION_REGION=
# Cloudflare 同源 API 代理使用；留空表示由 Supabase 自动选择区域。
SUPABASE_FUNCTION_REGION=
# 只有设为 true 且 Supabase 前端配置完整时才启用 Broadcast；false 时仍保留轻量版本校验。
VITE_V2_REALTIME_CHANGES_ENABLED=true

# Exchange-rate collection
ID_BUSINESS_V2_EXCHANGE_RATE_AUTO_ENABLED=true
ID_BUSINESS_V2_EXCHANGE_RATE_RUN_ON_STARTUP=false
ID_BUSINESS_V2_FREE_MANUAL_MODE=false
ID_BUSINESS_V2_EXCHANGE_RATE_STALE_MS=600000
ID_BUSINESS_V2_EXCHANGE_RATE_NETWORK_ENABLED=true
ID_BUSINESS_V2_EXCHANGE_RATE_CRON_SECRET=replace_with_at_least_32_random_characters
CURRENCY_RATE_PROVIDER=currencyapi
CURRENCY_API_KEY=replace_with_currencyapi_key
CURRENCY_RATE_REQUEST_TIMEOUT_MS=10000

# AWS MySQL encrypted off-instance backup (server-side AES-256 in private S3)
MYSQL_BACKUP_S3_BUCKET=
MYSQL_BACKUP_S3_PREFIX=mysql/daily
MYSQL_BACKUP_S3_REGION=ap-northeast-1
