# Application
NODE_ENV=development
APP_PORT=3000
APP_PUBLIC_URL=http://localhost:5374
CORS_ORIGIN=http://localhost:5374

# Database
DATABASE_URL=mysql://id_business_app:replace_with_url_encoded_password@localhost:3306/id_business_v2
COMPOSE_PROJECT_NAME=id-business-v2-prod
MYSQL_DATABASE=id_business_v2
MYSQL_USER=id_business_app
MYSQL_PASSWORD=replace_with_random_mysql_app_password
MYSQL_ROOT_PASSWORD=replace_with_random_mysql_root_password
MYSQL_HOST_PORT=3306

# Authentication
AUTH_PROVIDER=local
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

V2_TRUSTED_PROXY_SECRET=

# Sensitive fields
FIELD_ENCRYPTION_KEY=change_me_32_bytes_minimum
HASH_SECRET=change_me_hash_secret

# Initial administrator
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_admin_password
SEED_ADMIN_DISPLAY_NAME=管理员
SEED_ADMIN_RESET_PASSWORD=false

# Production read-only smoke account
SMOKE_TEST_USERNAME=
SMOKE_TEST_PASSWORD=

# Frontend
VITE_API_BASE_URL=/api
VITE_DEV_API_PROXY_TARGET=http://localhost:3000

# Exchange-rate collection
ID_BUSINESS_V2_EXCHANGE_RATE_AUTO_ENABLED=true
ID_BUSINESS_V2_EXCHANGE_RATE_RUN_ON_STARTUP=false
ID_BUSINESS_V2_FREE_MANUAL_MODE=false
ID_BUSINESS_V2_EXCHANGE_RATE_STALE_MS=600000
ID_BUSINESS_V2_EXCHANGE_RATE_NETWORK_ENABLED=true
ID_BUSINESS_V2_EXCHANGE_RATE_CRON_SECRET=replace_with_at_least_32_random_characters
CURRENCY_RATE_PROVIDER=exchange_rate_api
CURRENCY_RATE_REQUEST_TIMEOUT_MS=10000

# AWS MySQL encrypted off-instance backup (server-side AES-256 in private S3)
MYSQL_BACKUP_S3_BUCKET=replace-with-private-backup-bucket-name
MYSQL_BACKUP_S3_PREFIX=mysql/daily
MYSQL_BACKUP_S3_REGION=ap-northeast-1
MYSQL_BACKUP_LOCAL_RETENTION_COUNT=48
MYSQL_BACKUP_LOCAL_MAX_BYTES=1073741824
MYSQL_BACKUP_MIN_FREE_BYTES=2147483648
