[Unit]
Description=ID Business V2 MySQL logical backup
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
# 生产环境文件保持 root:root 0600，避免为自动备份放宽数据库与 S3 密钥权限。
User=root
Group=root
UMask=0077
ExecStart=/opt/id-business-v2/current/scripts/backup-aws-mysql.sh

[Install]
WantedBy=multi-user.target
