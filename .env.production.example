NODE_ENV=production
APP_PORT=3000
APP_PUBLIC_URL=https://admin.your-domain.com
CORS_ORIGIN=https://admin.your-domain.com

DATABASE_URL=postgresql://user:password@db.your-domain.com:5432/id_business_v2?schema=public
V2_RUNTIME_DATABASE_URL=postgresql://runtime_user:password@db.your-domain.com:6543/id_business_v2?schema=public&pgbouncer=true
AUDIT_DATABASE_URL=postgresql://audit_user:password@db.your-domain.com:5432/id_business_v2?schema=public
MIGRATION_DATABASE_URL=postgresql://migration_admin:password@db.your-domain.com:5432/id_business_v2?schema=public
BACKUP_DATABASE_URL=postgresql://backup_user:password@db.your-domain.com:5432/id_business_v2?schema=public

AUTH_PROVIDER=supabase
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=7d
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
SUPABASE_SECRET_KEY=replace_with_secret_key
SUPABASE_EDGE_FUNCTION=true
V2_TRUSTED_PROXY_SECRET=replace_with_at_least_32_random_characters
V2_DB_POOLER_HOST=aws-0-your-region.pooler.supabase.com

FIELD_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
HASH_SECRET=replace_with_at_least_32_random_characters

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace_with_strong_admin_password
SEED_ADMIN_DISPLAY_NAME=管理员
SEED_ADMIN_RESET_PASSWORD=false

VITE_API_BASE_URL=https://your-project.supabase.co/functions/v1/v2-api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
VITE_SUPABASE_FUNCTION_REGION=
VITE_V2_REALTIME_CHANGES_ENABLED=true

ID_BUSINESS_V2_EXCHANGE_RATE_AUTO_ENABLED=true
ID_BUSINESS_V2_EXCHANGE_RATE_RUN_ON_STARTUP=false
ID_BUSINESS_V2_FREE_MANUAL_MODE=false
ID_BUSINESS_V2_EXCHANGE_RATE_STALE_MS=600000
ID_BUSINESS_V2_EXCHANGE_RATE_CRON_SECRET=replace_with_at_least_32_random_characters
CURRENCY_RATE_PROVIDER=currencyapi
CURRENCY_API_KEY=replace_with_currencyapi_key
CURRENCY_RATE_REQUEST_TIMEOUT_MS=10000
