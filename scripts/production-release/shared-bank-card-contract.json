  "conflictQuery": "SELECT (SELECT COUNT(*) FROM (SELECT b.number_hash FROM id_business_v2_recharge_jobs j JOIN id_business_v2_bank_recharge_cards b ON b.id=j.card_id WHERE b.number_hash IS NOT NULL AND NOT (COALESCE(JSON_UNQUOTE(JSON_EXTRACT(j.result,'$.operator_resolution')),'')='confirmed_no_bank_request' AND COALESCE(JSON_UNQUOTE(JSON_EXTRACT(j.result,'$.status')),'')='payment_unknown_resolved') AND NOT EXISTS (SELECT 1 FROM id_business_v2_bank_recharge_orders r WHERE r.recharge_job_id=j.id AND (r.verified_at IS NOT NULL OR r.status IN ('completed','refunded'))) AND (j.state<>'finished' OR (JSON_EXTRACT(j.result,'$.payment_attempted')=TRUE AND COALESCE(JSON_UNQUOTE(JSON_EXTRACT(j.result,'$.payment_status')),'')<>'declined' AND COALESCE(JSON_UNQUOTE(JSON_EXTRACT(j.result,'$.status')),'')<>'subscription_activated')) GROUP BY b.number_hash HAVING COUNT(*)>1) q)+(SELECT COUNT(*) FROM (SELECT b.number_hash,j.id FROM id_business_v2_recharge_jobs j JOIN id_business_v2_bank_recharge_cards b ON b.id=j.card_id WHERE b.number_hash IS NOT NULL AND NOT (COALESCE(JSON_UNQUOTE(JSON_EXTRACT(j.result,'$.operator_resolution')),'')='confirmed_no_bank_request' AND COALESCE(JSON_UNQUOTE(JSON_EXTRACT(j.result,'$.status')),'')='payment_unknown_resolved') AND NOT EXISTS (SELECT 1 FROM id_business_v2_bank_recharge_orders r WHERE r.recharge_job_id=j.id AND (r.verified_at IS NOT NULL OR r.status IN ('completed','refunded'))) AND (j.state<>'finished' OR (JSON_EXTRACT(j.result,'$.payment_attempted')=TRUE AND COALESCE(JSON_UNQUOTE(JSON_EXTRACT(j.result,'$.payment_status')),'')<>'declined' AND COALESCE(JSON_UNQUOTE(JSON_EXTRACT(j.result,'$.status')),'')<>'subscription_activated'))) u JOIN online_recharge_cards o ON o.number_hash=u.number_hash WHERE o.lease_owner IS NOT NULL AND o.lease_owner<>u.id)",
