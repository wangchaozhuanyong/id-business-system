NODE_ENV=production
COMPOSE_PROJECT_NAME=id-business-v2-prod
APP_PORT=3000
APP_DOMAIN=admin.your-domain.com
APP_PUBLIC_URL=https://admin.your-domain.com
CORS_ORIGIN=https://admin.your-domain.com

MYSQL_DATABASE=id_business_v2
MYSQL_USER=id_business_app
MYSQL_PASSWORD=replace_with_random_mysql_app_password
MYSQL_ROOT_PASSWORD=replace_with_random_mysql_root_password
MYSQL_HOST_PORT=3306
DATABASE_URL=mysql://id_business_app:replace_with_url_encoded_password@mysql:3306/id_business_v2

AUTH_PROVIDER=local
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=7d
SUPABASE_EDGE_FUNCTION=false

FIELD_ENCRYPTION_KEY=replace_with_existing_production_key
HASH_SECRET=replace_with_existing_production_hash_secret

VITE_APP_TITLE=ID 业务管理系统
VITE_API_BASE_URL=/api
VITE_V2_REALTIME_CHANGES_ENABLED=true

ID_BUSINESS_V2_EXCHANGE_RATE_AUTO_ENABLED=false
ID_BUSINESS_V2_EXCHANGE_RATE_RUN_ON_STARTUP=false
ID_BUSINESS_V2_FREE_MANUAL_MODE=false
ID_BUSINESS_V2_EXCHANGE_RATE_STALE_MS=600000
ID_BUSINESS_V2_EXCHANGE_RATE_NETWORK_ENABLED=false
CURRENCY_RATE_PROVIDER=currencyapi
CURRENCY_API_KEY=
CURRENCY_RATE_REQUEST_TIMEOUT_MS=10000

MYSQL_BACKUP_S3_BUCKET=
MYSQL_BACKUP_S3_PREFIX=mysql/daily
MYSQL_BACKUP_S3_REGION=ap-northeast-1

DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=10
