  providerSnapshot IdBusinessV2ExchangeRateProviderSnapshot @relation(fields: [providerSnapshotId], references: [id], onDelete: Restrict)

  @@unique([providerSnapshotId, sourceAdId])
  @@index([providerSnapshotId, priceToRmb])
  @@index([createdAt])
  @@map("id_business_v2_exchange_rate_quote_samples")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles                UserRole[]
  rolePermissions          RolePermission[]
  sensitiveDisplayPolicies IdBusinessV2SensitiveDisplayPolicy[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  code      String   @unique @db.VarChar(150)
  module    String   @db.VarChar(100)
  action    String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([module, action])
  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId                    String  @map("role_id") @db.Uuid
  permissionId              String  @map("permission_id") @db.Uuid
  sensitiveApprovalRequired Boolean @default(false) @map("sensitive_approval_required")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([sensitiveApprovalRequired])
  @@map("role_permissions")
}

model IdBusinessV2SensitiveDisplayPolicy {
  id              String                              @id @default(uuid()) @db.Uuid
  roleId          String                              @map("role_id") @db.Uuid
  fieldKey        String                              @map("field_key") @db.VarChar(80)
  context         IdBusinessV2SensitiveDisplayContext
  mode            IdBusinessV2SensitiveDisplayMode
  createdByUserId String?                             @map("created_by_user_id") @db.Uuid
  updatedByUserId String?                             @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime                            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                            @updatedAt @map("updated_at") @db.Timestamptz(6)

  role      Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdBy User? @relation("IdBusinessV2SensitivePolicyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("IdBusinessV2SensitivePolicyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([roleId, fieldKey, context])
  @@index([roleId, context])
  @@index([fieldKey, context, mode])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@map("id_business_v2_sensitive_display_policies")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  module     String   @db.VarChar(100)
  action     String   @db.VarChar(100)
  objectType String?  @map("object_type") @db.VarChar(100)
  objectId   String?  @map("object_id") @db.Uuid
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ip         String?  @db.VarChar(100)
  userAgent  String?  @map("user_agent") @db.Text
  remark     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user               User?                           @relation(fields: [userId], references: [id], onDelete: SetNull)
  governanceJobItems IdBusinessV2GovernanceJobItem[] @relation("IdBusinessV2GovernanceItemAudit")

  @@index([userId])
  @@index([module, action])
  @@index([objectType, objectId])
  @@index([createdAt])
  @@map("audit_logs")
}

model IdBusinessV2GovernanceJob {
  id                String                          @id @default(uuid()) @db.Uuid
  jobNo             String                          @unique @map("job_no") @db.VarChar(48)
  type              IdBusinessV2GovernanceJobType
  status            IdBusinessV2GovernanceJobStatus @default(pending_approval)
  reason            String                          @db.Text
  backupEvidence    String                          @map("backup_evidence") @db.Text
  previewHash       String                          @map("preview_hash") @db.VarChar(64)
  previewSummary    Json                            @map("preview_summary")
  requestedByUserId String                          @map("requested_by_user_id") @db.Uuid
  executedByUserId  String?                         @map("executed_by_user_id") @db.Uuid
  totalItems        Int                             @default(0) @map("total_items")
  succeededItems    Int                             @default(0) @map("succeeded_items")
  skippedItems      Int                             @default(0) @map("skipped_items")
  failedItems       Int                             @default(0) @map("failed_items")
  idempotencyKey    String                          @unique @map("idempotency_key") @db.VarChar(160)
  approvedAt        DateTime?                       @map("approved_at") @db.Timestamptz(6)
  startedAt         DateTime?                       @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?                       @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)

  requestedBy User                               @relation("IdBusinessV2GovernanceJobRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  executedBy  User?                              @relation("IdBusinessV2GovernanceJobExecutedBy", fields: [executedByUserId], references: [id], onDelete: Restrict)
  items       IdBusinessV2GovernanceJobItem[]
  approval    IdBusinessV2GovernanceApproval?
  checkpoints IdBusinessV2GovernanceCheckpoint[]

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([requestedByUserId, createdAt])
  @@index([executedByUserId])
  @@map("id_business_v2_governance_jobs")
}

model IdBusinessV2GovernanceJobItem {
  id               String                           @id @default(uuid()) @db.Uuid
  jobId            String                           @map("job_id") @db.Uuid
  sequence         Int
  entityType       IdBusinessV2GovernanceEntityType @map("entity_type")
  entityId         String                           @map("entity_id") @db.Uuid
  safeLabel        String                           @map("safe_label") @db.VarChar(255)
  sourceDeletedAt  DateTime?                        @map("source_deleted_at") @db.Timestamptz(6)
  eligibility      Json
  status           IdBusinessV2GovernanceItemStatus @default(pending)
  resultCode       String?                          @map("result_code") @db.VarChar(120)
  resultMessage    String?                          @map("result_message") @db.Text
  resultAuditLogId String?                          @map("result_audit_log_id") @db.Uuid
  processedAt      DateTime?                        @map("processed_at") @db.Timestamptz(6)
  createdAt        DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)

  job            IdBusinessV2GovernanceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  resultAuditLog AuditLog?                 @relation("IdBusinessV2GovernanceItemAudit", fields: [resultAuditLogId], references: [id], onDelete: Restrict)

  @@unique([jobId, sequence])
  @@unique([jobId, entityType, entityId])
  @@index([jobId, status, sequence])
  @@index([entityType, entityId])
  @@index([resultAuditLogId])
  @@map("id_business_v2_governance_job_items")
}

model IdBusinessV2GovernanceApproval {
  id             String                                 @id @default(uuid()) @db.Uuid
  jobId          String                                 @unique @map("job_id") @db.Uuid
  approverUserId String                                 @map("approver_user_id") @db.Uuid
  decision       IdBusinessV2GovernanceApprovalDecision
  reason         String                                 @db.Text
  previewHash    String                                 @map("preview_hash") @db.VarChar(64)
  decidedAt      DateTime                               @default(now()) @map("decided_at") @db.Timestamptz(6)
  createdAt      DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)

  job      IdBusinessV2GovernanceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  approver User                      @relation("IdBusinessV2GovernanceApprovalApprover", fields: [approverUserId], references: [id], onDelete: Restrict)

  @@index([approverUserId, decidedAt])
  @@index([decision, decidedAt])
  @@map("id_business_v2_governance_approvals")
}

model IdBusinessV2GovernanceCheckpoint {
  id             String                                 @id @default(uuid()) @db.Uuid
  jobId          String                                 @map("job_id") @db.Uuid
  batchNo        Int                                    @map("batch_no")
  idempotencyKey String                                 @unique @map("idempotency_key") @db.VarChar(160)
  status         IdBusinessV2GovernanceCheckpointStatus @default(running)
  cursorSequence Int                                    @map("cursor_sequence")
  attemptedItems Int                                    @default(0) @map("attempted_items")
  succeededItems Int                                    @default(0) @map("succeeded_items")
  skippedItems   Int                                    @default(0) @map("skipped_items")
  failedItems    Int                                    @default(0) @map("failed_items")
  errorCode      String?                                @map("error_code") @db.VarChar(120)
  startedAt      DateTime                               @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?                              @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)

  job IdBusinessV2GovernanceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([jobId, batchNo])
  @@index([jobId, status])
  @@index([createdAt])
  @@map("id_business_v2_governance_checkpoints")
}

model V2AuthIdentity {
  id                  String    @id @default(uuid()) @db.Uuid
  authUserId          String    @unique @map("auth_user_id") @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  usernameNormalized  String    @unique @map("username_normalized") @db.VarChar(100)
  authEmail           String    @unique @map("auth_email") @db.VarChar(255)
  enabled             Boolean   @default(true)
  mustResetPassword   Boolean   @default(true) @map("must_reset_password")
  lastAuthenticatedAt DateTime? @map("last_authenticated_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
