+// 充值执行环境唯一拼装入口：生产任务与后台调试共用，改充值参数只改这里。
+// 只影响启动前注入的环境变量；执行步骤、填卡、付款、重试仍由同一套 index.js 完成。
+function buildCheckoutWorkerEnv({
+    jobKey = '',
+    cdk = '',
+    token,
+    sessionRaw,
+    planType,
+    region,
+    proxy,
+    hcaptchaEnv = {},
+    debug = null
+}) {
+    const base = {
+        ...process.env,
+        ...hcaptchaEnv,
+        // 跳过 API 建单：该路径每次都被上游 400 拒绝，且会用非浏览器指纹请求 /api/auth/session，
+        // 有作废真实会话的风险。默认走网页流程；需要时可用 CHECKOUT_MODE=api 显式恢复。
+        CHECKOUT_MODE: String(process.env.CHECKOUT_MODE || 'ui'),
+        CHATGPT_TOKEN: token,
+        CHATGPT_SESSION_JSON: String(sessionRaw || '').startsWith('{') ? sessionRaw : '',
+        CDK_PLAN_TYPE: planType,
+        PAYMENT_REGION_OVERRIDE: region,
+        PROXY: proxy
+    };
+    if (debug) {
+        return {
+            ...base,
+            CHECKOUT_DEBUG_ONLY: '1',
+            CHECKOUT_API_ONLY: debug.apiOnly ? '1' : '0',
+            CHECKOUT_DEBUG_FILL: debug.cardJson ? '1' : '0',
+            DEBUG_CARD_JSON: debug.cardJson || '',
+            PLAN_NAME_OVERRIDE: debug.planNameOverride || '',
+            ACTIVATION_EMAIL: debug.email || '',
+            CDK_CODE: ''
+        };
+    }
+    return { ...base, JOB_KEY: jobKey, CDK_CODE: cdk };
+}
