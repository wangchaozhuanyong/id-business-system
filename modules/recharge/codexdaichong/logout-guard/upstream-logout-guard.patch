+// LOGOUT_GUARD: 地区选择器的候选里包含 button[aria-haspopup="menu"]，账号头像菜单同样有该属性。
+// 一旦点开到账号菜单，后续选项匹配会落到 "Log out" 上，页面会导航到 /auth/logout 并吊销会话，
+// 连带把账号原主人踢下线（实测任务 #50）。这里在协议层直接封死登出导航，任何误点都不会生效。
+async function guardLogoutNavigation(page) {
+    if (!page || page.__logoutGuardInstalled) return;
+    page.__logoutGuardInstalled = true;
+    try {
+        await page.route('**/auth/logout*', (route) => {
+            console.warn('[防护] 拦截到登出导航，已阻止: ' + String(route.request().url()).slice(0, 80));
+            return route.abort();
+        });
+    } catch (error) {
+        console.warn('[防护] 登出导航拦截安装失败: ' + error.message);
+    }
+}
