+const PRO_TIER_LABEL = Object.freeze({
+    100: /standard/i,
+    200: /more\s*usage/i,
+    500: /max\s*usage/i
+});
+
+async function readCheckedTierText(group) {
+    return (await group.getByRole('radio', { checked: true }).innerText().catch(() => '') || '').replace(/\s+/g, ' ').trim();
+}
+
+async function selectProTierOnCheckout(page, group, tier) {
+    const tierPattern = PRO_TIER_LABEL[String(tier)];
+    if (!tierPattern) return;
+    for (let attempt = 0; attempt < 4; attempt += 1) {
+        const checkedText = await readCheckedTierText(group);
+        if (tierPattern.test(checkedText)) return;
+        const tierRadio = group.getByRole('radio').filter({ hasText: tierPattern }).first();
+        if (await tierRadio.count().catch(() => 0) === 0) {
+            throw new Error(`结账页找不到 Pro ${tier} 档位，已停止开通`);
+        }
+        // 先点控件本身，不行再点它的父级（label 包裹时点父级才生效）
+        await tierRadio.click({ timeout: 8000 }).catch(() => {});
+        for (let i = 0; i < 6; i += 1) {
+            await page.waitForTimeout(700);
+            if (tierPattern.test(await readCheckedTierText(group))) return;
+        }
+        await tierRadio.locator('xpath=..').click({ timeout: 6000 }).catch(() => {});
+        for (let i = 0; i < 6; i += 1) {
+            await page.waitForTimeout(700);
+            if (tierPattern.test(await readCheckedTierText(group))) return;
+        }
+        await tierRadio.focus().catch(() => {});
+        await page.keyboard.press('Space').catch(() => {});
+        for (let i = 0; i < 6; i += 1) {
+            await page.waitForTimeout(700);
+            if (tierPattern.test(await readCheckedTierText(group))) return;
+        }
+    }
+    const stuck = await readCheckedTierText(group);
+    throw new Error(`结账页未能切换到 Pro ${tier} 档位（当前选中: ${stuck.slice(0, 30)}），已停止开通`);
