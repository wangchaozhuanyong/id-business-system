+// Pro 与 0 元结账页没有卡号输入框，只能按结账摘要判定页面已就绪。
+async function isCheckoutSummaryReady(page) {
+    const body = String(await page.textContent('body', { timeout: 5000 }).catch(() => '') || '');
+    // 结账服务明确失败：不能当成"无卡结账页"，必须报错（通常是出口 IP 被风控）。
+    if (/could not be completed|Something went wrong|checkout session has expired/i.test(body)) {
+        const failure = new Error('结账页返回错误：Checkout could not be completed（出口 IP 可能被风控，请更换代理后重试）');
+        failure.checkoutPageError = true;
+        throw failure;
+    }
+    // 加载过渡页（Getting your plan ready / Loading checkout）内容不全，不能当作已就绪。
+    if (/Getting your plan ready|Loading checkout|Just a moment/i.test(body)) {
+        return false;
+    }
+    if (!/(?:Total due today|Due today|Subscribe|Start trial|Start free trial|Claim\s+(?:your\s+)?free\s+offer)/i.test(body)) {
+        return false;
+    }
+    const cardSelector = ['input[autocomplete="cc-number"]', 'input[name="cardnumber"]', 'input[name="number"]'].join(', ');
+    for (const frame of page.frames()) {
+        const count = await frame.locator(cardSelector).count().catch(() => 0);
+        if (count) return false;
+    }
+    return true;
+}
