+    const token = String(accessToken || '').trim();
+    if (!token) return Promise.resolve(null);
+    return new Promise((resolve) => {
+        const request = https.request({
+            host: 'chatgpt.com',
+            path: '/backend-api/accounts/check/v4-2023-04-27',
+            method: 'GET',
+            headers: { Authorization: 'Bearer ' + token, Accept: 'application/json' }
+        }, (response) => {
+            let body = '';
+            response.on('data', (chunk) => { body += chunk; });
+            response.on('end', () => {
+                try {
+                    const parsed = JSON.parse(body);
+                    const plans = Object.values(parsed.accounts || {})
+                        .map((item) => item && item.account && item.account.plan_type)
+                        .filter(Boolean);
+                    const paid = plans.find((plan) => plan && plan !== 'free');
+                    resolve({ planType: paid || 'free', plans });
+                } catch (_) { resolve(null); }
+            });
+        });
+        request.on('error', () => resolve(null));
+        request.setTimeout(15000, () => { request.destroy(); resolve(null); });
+        request.end();
+    });
+}
