+// Plus 0 元试用：卡片出现 "Try Plus free for 1 month"、"Claim free offer" 或 0 元月费。
+async function findPlusFreeTrialOffer(page) {
+    const banner = page.getByText(PLUS_FREE_TRIAL_BANNER).first();
+    if (await banner.isVisible({ timeout: 800 }).catch(() => false)) {
+        return normalizeOptionText(await banner.innerText().catch(() => '')) || 'Plus free trial';
+    }
+
+    const titles = page.getByText(/^(?:ChatGPT\\s+)?Plus$/i);
+    for (let index = 0; index < await titles.count(); index++) {
+        const title = titles.nth(index);
+        if (!(await title.isVisible().catch(() => false))) continue;
+
+        const card = title.locator('xpath=ancestor::*[self::div or self::section or self::article][.//button][1]');
+        const button = card.getByRole('button', { name: FREE_TRIAL_CLAIM_BUTTON });
+        if (await button.count() && await button.first().isVisible().catch(() => false)) {
+            return normalizeOptionText(await button.first().innerText().catch(() => '')) || 'Claim free offer';
+        }
+
+        const cardText = normalizeOptionText(await card.innerText().catch(() => ''));
+        if (FREE_TRIAL_ZERO_PRICE.test(cardText)) return '0 / month';
+    }
+    return '';
+}
